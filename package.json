{
  "name": "civilization-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Theoretical lab for deterministic, multi-level civilisation histories (stone age to interplanetary futures or extinction), destined for Universe Atlas.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "scenario": "node src/cli.mjs",
    "digest": "node src/cli.mjs --digest",
    "perf": "node tools/perf-civ.mjs",
    "perf:panel": "node tools/perf-civ.mjs 400000 --panel civ-m2a-1,civ-m2a-2,civ-m2a-6"
  }
}
